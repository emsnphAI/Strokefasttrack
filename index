<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stroke Fast Track & LVO Assessment</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Sarabun', sans-serif; background-color: #f3f4f6; }
        .tab-btn.active { border-bottom: 2px solid #ef4444; color: #ef4444; font-weight: bold; }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="text-gray-800 relative">

<div class="max-w-md mx-auto bg-white min-h-screen shadow-lg relative">
    <div class="bg-red-600 text-white p-4 text-center shadow-md">
        <h1 class="text-xl font-bold"><i class="fas fa-brain mr-2"></i>Stroke Assessment App</h1>
        <p class="text-sm">BE-FAST & FAST-ED (LVO) Triage</p>
    </div>

    <div class="flex justify-around bg-gray-100 border-b">
        <button id="tab-assess" class="tab-btn active w-1/2 py-3" onclick="switchTab('assess')">
            <i class="fas fa-stethoscope mr-1"></i> ประเมินผู้ป่วย
        </button>
        <button id="tab-history" class="tab-btn w-1/2 py-3" onclick="switchTab('history')">
            <i class="fas fa-history mr-1"></i> ประวัติย้อนหลัง
        </button>
    </div>

    <div id="assess-view" class="p-4">
        <form id="strokeForm">
            <div class="bg-blue-50 p-3 rounded-lg mb-4 border border-blue-200">
                <h2 class="font-bold text-blue-800 mb-2 border-b border-blue-200 pb-1">ข้อมูลเวลา (Time & Onset)</h2>
                <div class="mb-2">
                    <label class="block text-sm font-medium">ชื่อผู้ป่วย / รหัส (HN):</label>
                    <input type="text" id="patientName" required class="w-full mt-1 p-2 border rounded-md" placeholder="เช่น นายสมชาย หรือ HN12345">
                </div>
                <div class="mb-2">
                    <label class="block text-sm font-medium text-red-600">Last Known Well (เวลาปกติล่าสุด):</label>
                    <input type="datetime-local" id="timeLkw" class="w-full mt-1 p-2 border rounded-md">
                </div>
                <div class="mb-2">
                    <label class="block text-sm font-medium text-red-600">Time of Onset (เวลาที่เริ่มมีอาการ):</label>
                    <input type="text" id="timeOnset" class="w-full mt-1 p-2 border rounded-md" placeholder="เช่น 08.00 น. หรือ ตื่นมาก็เป็น / ไม่ทราบเวลา">
                </div>
            </div>

            <div class="bg-gray-50 p-3 rounded-lg mb-4 border border-gray-200">
                <h2 class="font-bold text-gray-800 mb-2 border-b pb-1">BE-FAST (Screening)</h2>
                <label class="flex items-center space-x-2 mb-2">
                    <input type="checkbox" id="befast_b" class="w-5 h-5 text-red-600 rounded">
                    <span><b>B</b>alance: เสียการทรงตัว เดินเซ</span>
                </label>
                <label class="flex items-center space-x-2 mb-2">
                    <input type="checkbox" id="befast_e" class="w-5 h-5 text-red-600 rounded">
                    <span><b>E</b>yes: ตามัว มองไม่เห็นภาพซ้อนทันที</span>
                </label>
                <label class="flex items-center space-x-2 mb-2">
                    <input type="checkbox" id="befast_f" class="w-5 h-5 text-red-600 rounded">
                    <span><b>F</b>ace: หน้าเบี้ยว มุมปากตก</span>
                </label>
                <label class="flex items-center space-x-2 mb-2">
                    <input type="checkbox" id="befast_a" class="w-5 h-5 text-red-600 rounded">
                    <span><b>A</b>rms: แขนขาอ่อนแรงครึ่งซีก</span>
                </label>
                <label class="flex items-center space-x-2">
                    <input type="checkbox" id="befast_s" class="w-5 h-5 text-red-600 rounded">
                    <span><b>S</b>peech: พูดไม่ชัด นึกคำพูดไม่ออก</span>
                </label>
            </div>

            <div class="bg-yellow-50 p-3 rounded-lg mb-4 border border-yellow-200">
                <h2 class="font-bold text-yellow-800 mb-2 border-b pb-1">FAST-ED (LVO Severity)</h2>
                
                <div class="mb-3">
                    <label class="block font-medium mb-1">Facial Palsy (หน้าเบี้ยว)</label>
                    <select id="fasted_f" class="w-full p-2 border rounded bg-white">
                        <option value="0">0 - ปกติ หรือเบี้ยวเล็กน้อย</option>
                        <option value="1">1 - อัมพาตครึ่งซีกชัดเจน (Partial/Complete)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="block font-medium mb-1">Arm Weakness (แขนอ่อนแรง)</label>
                    <select id="fasted_a" class="w-full p-2 border rounded bg-white">
                        <option value="0">0 - ไม่มีแขนตก (No drift)</option>
                        <option value="1">1 - แขนตกลงต้านแรงโน้มถ่วงได้บ้าง (Drift)</option>
                        <option value="2">2 - ต้านแรงโน้มถ่วงไม่ได้เลย / ไม่ขยับ (No effort)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="block font-medium mb-1">Speech Changes (การพูด)</label>
                    <select id="fasted_s" class="w-full p-2 border rounded bg-white">
                        <option value="0">0 - ปกติ</option>
                        <option value="1">1 - พูดผิดปกติเล็กน้อยถึงปานกลาง</option>
                        <option value="2">2 - ไม่พูดเลย, ไม่เข้าใจคำสั่ง (Severe/Global aphasia)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="block font-medium mb-1">Eye Deviation (ตากลอก)</label>
                    <select id="fasted_e" class="w-full p-2 border rounded bg-white">
                        <option value="0">0 - ปกติ</option>
                        <option value="1">1 - กรอกตาผิดปกติบางส่วน (Partial)</option>
                        <option value="2">2 - ตากลอกไปด้านใดด้านหนึ่งชัดเจน ข้ามเส้นกลางไม่ได้ (Forced)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="block font-medium mb-1">Denial / Neglect (การละเลยร่างกาย)</label>
                    <select id="fasted_d" class="w-full p-2 border rounded bg-white">
                        <option value="0">0 - ปกติ</option>
                        <option value="1">1 - ละเลยสัมผัสด้านใดด้านหนึ่ง (Extinction)</option>
                        <option value="2">2 - ไม่รับรู้แขนขาตัวเอง หรือละเลยครึ่งซีกชัดเจน (Doesn't recognize own hand)</option>
                    </select>
                </div>
            </div>

            <button type="button" onclick="evaluatePatient()" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-lg shadow-lg text-lg transition duration-200">
                ประมวลผล & บันทึก
            </button>
        </form>

        <div id="resultBox" class="mt-4 hidden rounded-lg p-4 text-center shadow-md animate-pulse">
            <h2 id="resultTitle" class="text-xl font-bold mb-2"></h2>
            <p id="resultLVO" class="text-md font-semibold"></p>
            <p id="resultScore" class="text-3xl font-black mt-2"></p>
            <p id="resultTime" class="text-sm mt-2 font-medium"></p>
        </div>
    </div>

    <div id="history-view" class="p-4 hidden">
        <div class="flex justify-between items-center mb-4">
            <h2 class="font-bold text-lg text-gray-800">ประวัติการประเมิน</h2>
            <button onclick="clearHistory()" class="text-sm text-red-600 border border-red-600 px-2 py-1 rounded hover:bg-red-50">ล้างข้อมูล</button>
        </div>
        <div id="historyList" class="space-y-3">
            </div>
    </div>
</div>

<div id="activationModal" class="fixed inset-0 bg-black bg-opacity-70 hidden flex items-center justify-center z-50 px-4">
    <div class="bg-white rounded-xl shadow-2xl p-6 w-full max-w-sm text-center transform transition-all">
        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-4">
            <i class="fas fa-siren-on text-3xl text-red-600 fa-bullhorn"></i>
        </div>
        <h3 class="text-2xl leading-6 font-bold text-gray-900 mb-2">Activate Stroke Fast Track Team</h3>
        <p class="text-sm text-gray-500 mb-4">พบความผิดปกติจาก BE-FAST <br>กรุณากดยืนยันเพื่อบันทึกเวลา (Time Stamp)</p>
        
        <div id="modalLvoAlert" class="bg-yellow-100 text-yellow-800 px-3 py-2 rounded mb-4 font-semibold text-sm hidden">
            ⚠️ สงสัย LVO (FAST-ED Score ≥ 4)
        </div>

        <div class="mt-5 flex flex-col space-y-2">
            <button onclick="confirmActivation()" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-3 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:text-sm">
                ยืนยันการ Activate (บันทึกเวลา)
            </button>
            <button onclick="closeModal()" class="w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-3 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 sm:text-sm">
                ยกเลิก (บันทึกแบบไม่ Activate)
            </button>
        </div>
    </div>
</div>

<script>
    // Set Default LKW Time to Now (Onset ปล่อยว่างเพราะเป็น Text)
    document.getElementById('timeLkw').value = new Date().toISOString().slice(0, 16);

    // Load History from Local Storage
    let records = JSON.parse(localStorage.getItem('strokeRecords')) || [];
    let tempEvalData = null; // เก็บข้อมูลชั่วคราวก่อนกดยืนยันใน Pop-up

    function switchTab(tab) {
        document.getElementById('tab-assess').classList.remove('active');
        document.getElementById('tab-history').classList.remove('active');
        document.getElementById('assess-view').classList.add('hidden');
        document.getElementById('history-view').classList.add('hidden');

        document.getElementById(`tab-${tab}`).classList.add('active');
        document.getElementById(`${tab}-view`).classList.remove('hidden');

        if(tab === 'history') renderHistory();
    }

    function evaluatePatient() {
        const name = document.getElementById('patientName').value;
        if(!name) { alert('กรุณากรอกชื่อผู้ป่วย / HN'); return; }

        const lkw = document.getElementById('timeLkw').value;
        const onset = document.getElementById('timeOnset').value || 'ไม่ระบุ/ไม่แน่ชัด';

        // Check BE-FAST
        const isBeFastPositive = 
            document.getElementById('befast_b').checked ||
            document.getElementById('befast_e').checked ||
            document.getElementById('befast_f').checked ||
            document.getElementById('befast_a').checked ||
            document.getElementById('befast_s').checked;

        // Calculate FAST-ED Score
        const fastedScore = 
            parseInt(document.getElementById('fasted_f').value) +
            parseInt(document.getElementById('fasted_a').value) +
            parseInt(document.getElementById('fasted_s').value) +
            parseInt(document.getElementById('fasted_e').value) +
            parseInt(document.getElementById('fasted_d').value);

        // เก็บข้อมูลชั่วคราวไว้รอบันทึก
        tempEvalData = {
            name: name,
            lkw: lkw ? new Date(lkw).toLocaleString('th-TH') : 'ไม่ระบุ',
            onset: onset,
            fastedScore: fastedScore,
            isLvo: fastedScore >= 4,
            isFastTrack: isBeFastPositive
        };

        if (isBeFastPositive) {
            // แสดง Pop-up Modal
            document.getElementById('activationModal').classList.remove('hidden');
            if(fastedScore >= 4){
                document.getElementById('modalLvoAlert').classList.remove('hidden');
            } else {
                document.getElementById('modalLvoAlert').classList.add('hidden');
            }
        } else {
            // ถ้าไม่เข้าเกณฑ์ ให้บันทึกเลยโดยไม่มี Timestamp ของการ Activate
            saveRecord(false);
        }
    }

    function confirmActivation() {
        document.getElementById('activationModal').classList.add('hidden');
        saveRecord(true); // true = มีการ Activate Stroke Fast Track
    }

    function closeModal() {
        document.getElementById('activationModal').classList.add('hidden');
        saveRecord(false); // ปิดเฉยๆ ก็บันทึกข้อมูลแต่ถือว่าไม่ได้ลงเวลา Activate
    }

    function saveRecord(isActivated) {
        if(!tempEvalData) return;

        const now = new Date();
        const timestamp = now.toLocaleString('th-TH');
        
        let action = "ปกติ / ไม่เข้าเกณฑ์ Stroke";
        let lvoRisk = "ความเสี่ยง LVO ต่ำ";
        let bgColor = "bg-green-100 text-green-800";
        let activateTimeStr = "";

        if (tempEvalData.isFastTrack) {
            action = isActivated ? "🚨 STROKE FAST TRACK ACTIVATED 🚨" : "เกณฑ์เข้า Stroke แต่ข้ามการ Activate";
            bgColor = isActivated ? "bg-red-100 text-red-800 border border-red-300" : "bg-orange-100 text-orange-800";
            
            if(tempEvalData.isLvo) lvoRisk = "⚠️ สงสัย Large Vessel Occlusion (LVO) สูง";
            else lvoRisk = "ความน่าจะเป็น LVO ต่ำ";

            if(isActivated) {
                activateTimeStr = `<br><span class='text-red-600'><i class='fas fa-stopwatch'></i> เวลา Activate: ${timestamp}</span>`;
            }
        }

        // Show Result UI
        const resultBox = document.getElementById('resultBox');
        resultBox.className = `mt-4 rounded-lg p-4 text-center shadow-md ${bgColor}`;
        document.getElementById('resultTitle').innerHTML = action;
        document.getElementById('resultLVO').innerText = lvoRisk;
        document.getElementById('resultScore').innerText = `FAST-ED Score: ${tempEvalData.fastedScore}`;
        document.getElementById('resultTime').innerHTML = activateTimeStr;
        resultBox.classList.remove('hidden');

        // Save Data to Array
        const record = {
            id: Date.now(),
            ...tempEvalData,
            timestamp: timestamp,
            activationTime: isActivated ? timestamp : '-'
        };

        records.unshift(record); // Add to top
        localStorage.setItem('strokeRecords', JSON.stringify(records));
        
        // --- รีเซ็ตฟอร์ม (Reset Form) ---
        document.getElementById('strokeForm').reset();
        // ตั้งค่าเวลา Last Known Well กลับเป็นเวลาปัจจุบัน
        document.getElementById('timeLkw').value = new Date().toISOString().slice(0, 16);
        
        // เลื่อนหน้าจอลงมาดูผลลัพธ์
        setTimeout(() => {
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        }, 100);
    }

    function renderHistory() {
        const historyList = document.getElementById('historyList');
        historyList.innerHTML = '';

        if(records.length === 0) {
            historyList.innerHTML = '<p class="text-center text-gray-500 mt-4">ยังไม่มีประวัติการประเมิน</p>';
            return;
        }

        records.forEach(rec => {
            const statusColor = rec.isFastTrack ? (rec.isLvo ? 'bg-red-500' : 'bg-orange-500') : 'bg-gray-400';
            const statusText = rec.isFastTrack ? (rec.isLvo ? 'FAST TRACK + LVO' : 'FAST TRACK') : 'Negative';

            const card = `
                <div class="bg-white p-3 rounded shadow border-l-4 ${rec.isLvo ? 'border-red-500' : (rec.isFastTrack ? 'border-orange-500' : 'border-gray-400')} relative">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="font-bold text-lg">${rec.name}</span>
                            <div class="text-xs text-gray-500 mt-1">Onset: ${rec.onset}</div>
                        </div>
                        <span class="text-xs text-white px-2 py-1 rounded shadow-sm ${statusColor}">${statusText}</span>
                    </div>
                    <div class="text-sm text-gray-700 mt-2 bg-gray-50 p-2 rounded">
                        <p class="flex justify-between"><span>FAST-ED Score:</span> <span class="font-bold text-lg">${rec.fastedScore}</span></p>
                        ${rec.activationTime !== '-' ? `<p class="flex justify-between text-red-600 mt-1 border-t pt-1"><span><i class="fas fa-bell"></i> Activate:</span> <span class="font-semibold">${rec.activationTime}</span></p>` : ''}
                    </div>
                    <div class="text-[10px] text-gray-400 mt-2 text-right">บันทึกเมื่อ: ${rec.timestamp}</div>
                </div>
            `;
            historyList.innerHTML += card;
        });
    }

    function clearHistory() {
        if(confirm("ยืนยันการล้างประวัติทั้งหมด?")) {
            localStorage.removeItem('strokeRecords');
            records = [];
            renderHistory();
        }
    }
</script>

</body>
</html>
